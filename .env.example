# Groq API Key for LLM summarization and extraction
GROQ_API_KEY=your_groq_api_key_here

# Google Workspace Service Account JSON path for the Custom MCP Server
GOOGLE_APPLICATION_CREDENTIALS=./config/service_account.json

# Target Google Doc ID for appending the weekly report
TARGET_GOOGLE_DOC_ID=your_google_doc_id_here

# Stakeholder Email Addresses (comma separated)
STAKEHOLDER_EMAILS=stakeholder1@example.com,stakeholder2@example.com

# Target App Package Name (Groww on Google Play)
TARGET_APP_PACKAGE=com.nextbillion.groww

# Number of weeks to look back for reviews (default: 8)
REVIEW_WINDOW_WEEKS=8
